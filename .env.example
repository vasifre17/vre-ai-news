# Copy this file to .env and fill in all values before production use.
# VREYC production launch domain: https://vreyc.com
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
ADMIN_USERNAME=replace-with-production-admin-user
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
OPENAI_API_KEY=sk-...
PEXELS_API_KEY=...
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgresql+psycopg2://vre_user:replace-with-strong-db-password@db:5432/vre_news
SITE_URL=https://vreyc.com
PUBLISH_MODE=manual
FETCH_INTERVAL_MIN=15
# Uploaded article/hero images. Docker Compose mounts the host directory
# /opt/vre-ai-news/static/uploads/images to this container path so rebuilds never delete uploads.
IMAGE_UPLOAD_DIR=/app/static/uploads/images
IMAGE_UPLOAD_URL_PREFIX=/static/uploads/images
